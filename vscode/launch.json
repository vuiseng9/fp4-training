    "version": "0.2.0",
    "configurations": [
        {
            "name": "vs-py",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {},
            "cwd": "${workspaceFolder}",
            "program": "quantized-training/custom/swizzle.py",
            "args": []
        },
        {
            "name": "lt-cublas LtNvfp4Matmul",
            "type": "cppdbg",
            "request": "launch",
            "program": "/root/work/dev/non-te/cuda-lib-samples/lt-cublas/build/LtNvfp4Matmul/sample_cublasLt_LtNvfp4Matmul",
            "args": [],
            "stopAtEntry": true,
            "cwd": "/root/work/dev/non-te/cuda-lib-samples/lt-cublas/LtNvfp4Matmul",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Python dev",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/quantized-training",
                // "CUBLASLT_LOG_LEVEL": "2",
                // "CUBLASLT_LOG_LEVEL": "5",
                // "CUBLASLT_LOG_MASK": "31",
            },
            "cwd": "${workspaceFolder}/quantized-training",
            "program": 
            // "scripts/102_custom_cublaslt_mxfp8_bf16.py",
            "scripts/102_custom_cublaslt_mxfp8_fp32.py",
            // "program": "scripts/100_custom_fp32.py",
            // "program": "scripts/00_fp32.py",
            // "program": "scripts/01_fp16.py",
            // "program": "scripts/02_fp8_delayed_scaling.py",
            // "program": "scripts/03_fp8_current_scaling.py",
            // "program": "scripts/04_fp8_block_scaling.py",
            // "program": "scripts/05_mxfp8_block_scaling.py",
            "args": []
        },
        {
            "name": "Launch Python, break at CPP only",
            "type": "cppdbg",
            "request": "launch",
            "program": "/usr/bin/python3",  // or path to your Python interpreter
            "args": [
                // "scripts/102_custom_cublaslt_mxfp8_bf16.py",
                "scripts/102_custom_cublaslt_mxfp8_fp32.py"
            ],
            "stopAtEntry": false,
            "cwd": "/root/work/dev/vsqt/quantized-training",
            "environment": [
                {
                    "name": "PYTHONPATH",
                    "value": "${workspaceFolder}/quantized-training"
                },
                // {
                //     "name": "CUBLASLT_LOG_LEVEL",
                //     "value": "5"
                // },
                // {
                //     "name": "CUBLASLT_LOG_MASK",
                //     "value": "31"
                // }
            ],
            "externalConsole": false,
            "MIMode": "gdb",  // or "lldb" on macOS
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Load Python extensions",
                    "text": "source /usr/share/gdb/auto-load/usr/bin/python3.12-gdb.py", // not working (no stopping at python script), not sure why
                    "ignoreFailures": true
                }
            ],
            // "preLaunchTask": "build-debug"  // Optional: build your extension first
        },
    ]
