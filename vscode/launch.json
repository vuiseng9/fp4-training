{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Python, break at CPP only",
            "type": "cppdbg",
            "request": "launch",
            "program": "/usr/bin/python3",  // or path to your Python interpreter
            "args": ["scripts/05_mxfp8_block_scaling.py"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/quantized-training",
            "environment": [
                {
                    "name": "PYTHONPATH",
                    "value": "${workspaceFolder}/quantized-training"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",  // or "lldb" on macOS
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Load Python extensions",
                    "text": "source /usr/share/gdb/auto-load/usr/bin/python3.12-gdb.py", // not working (no stopping at python script), not sure why
                    "ignoreFailures": true
                }
            ],
            // "preLaunchTask": "build-debug"  // Optional: build your extension first
        },
        {
            "name": "i Python debug",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/quantized-training"
            },
            "cwd": "${workspaceFolder}/quantized-training",
            "program": "${file}",
            "args": []
        },
        {
            "name": "debugpy_launch",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "justMyCode": false,
            "stopOnEntry": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/quantized-training"
            },
            "cwd": "${workspaceFolder}/quantized-training",
            "program": "scripts/00_fp32.py",
            "args": []
        },
        {
            "name": "gdb_attach",
            "type": "cppdbg",
            "request": "attach",
            "program": "/usr/bin/python3",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "processId": "${command:pickProcess}",
            // "processId": "${input:pythonPID}",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
            ]
        },
    ],
    "compounds": [
        {
            "name": "Compound",
            "configurations": ["debugpy_launch", "gdb_attach"],
            "stopAll": true
        }
    ],
}