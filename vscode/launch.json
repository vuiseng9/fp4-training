    "version": "0.2.0",
    "configurations": [
        {
            "name": "Custom Linear, train TinyViT MNIST",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/",
                // to dump cublaslt logs, useful to verify matmul precision and details
                // "CUBLASLT_LOG_LEVEL": "2",
                // "CUBLASLT_LOG_FILE": "./log.cublaslt" 
            },
            "cwd": "${workspaceFolder}/",
            "program": "main_train_tinyvit_mnist.py",
            "args": [
                // "-h"
                "--impl", 
                // uncomment one of the implementations below to test
                // "torch",
                // "torch", "--fp32",
                // "custom_py",
                // "custom_py", "--fp32",
                // "custom_aten",
                // "custom_aten", "--fp32",
                // "cublaslt",
                // "cublaslt", "--fp32",
                // "cublaslt_mxfp8",
                // "cublaslt_mxfp8", "--fp32",
                "cublaslt_nvfp4",
                // "cublaslt_nvfp4", "--fp32",
                // "cublaslt_nvf4_fw_mxf8_bw",
                // "cublaslt_nvf4_fw_mxf8_bw", "--fp32"
            ]
        },
        {
            "name": "via Transformer Engine Recipe",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/",
                // to dump cublaslt logs, useful to verify matmul precision and details
                // "CUBLASLT_LOG_LEVEL": "2",
                // "CUBLASLT_LOG_FILE": "./log.cublaslt" 
            },
            "cwd": "${workspaceFolder}/",
            "program": "main_te_train_tinyvit_mnist.py",
            "args": [
                // "-h"
                "--recipe",
                // uncomment one of the implementations below to test
                    // "base",
                    // "base", "--fp32",
                    // "f8",
                    // "f8", "--fp32",
                    // "mxfp8",
                    // "mxfp8", "--fp32",
                    "nvfp4",
                    // "nvfp4", "--fp32",
            ]
        },
        {
            "name": "quantize",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {},
            "cwd": "${workspaceFolder}/qt/custom",
            "program": "custom/quantize.py",
            "args": []
        },
        {
            "name": "swizzle",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {},
            "cwd": "${workspaceFolder}/",
            "program": "custom/swizzle.py",
            "args": []
        },
        {
            "name": "[CPP] Launch Python, break at CPP only",
            "type": "cppdbg",
            "request": "launch",
            "program": "/usr/bin/python3",  // or path to your Python interpreter
            "args": [
                "main_train_tinyvit_mnist.py", "--impl", 
                "cublaslt_mxfp8",
                // "cublaslt_mxfp8", "--fp32",
                // "cublaslt_nvfp4",
                // "cublaslt_nvfp4", "--fp32",
                // "cublaslt_nvf4_fw_mxf8_bw",
                // "cublaslt_nvf4_fw_mxf8_bw", "--fp32"
            ],
            "stopAtEntry": false,
            "cwd": "/workspace/fp4-training/",
            "environment": [
                {
                    "name": "PYTHONPATH",
                    "value": "${workspaceFolder}/"
                },
                // {
                //     "name": "CUBLASLT_LOG_LEVEL",
                //     "value": "2"
                // },
                // {
                //     "name": "CUBLASLT_LOG_MASK",
                //     "value": "31"
                // }
            ],
            "externalConsole": false,
            "MIMode": "gdb",  // or "lldb" on macOS
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Load Python extensions",
                    "text": "source /usr/share/gdb/auto-load/usr/bin/python3.12-gdb.py", // not working (no stopping at python script), not sure why
                    "ignoreFailures": true
                }
            ],
            // "preLaunchTask": "build-debug"  // Optional: build your extension first
        },

    ]
}